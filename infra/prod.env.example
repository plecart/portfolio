# Modèle du `.env` de production, posé sur le VPS à côté de `compose.yml`, que Compose lit pour
# l'interpolation `${…}`. Aucune valeur réelle ici : `infra/bootstrap.sh` écrit ce `.env` depuis
# les secrets, jamais à la main (cadrage §6.6, §6.7 point 1) — il lit ici le nom des variables, et
# n'écrit qu'elles.
#
# Compose interpole aussi les valeurs de ce fichier : un `$` y est lu comme une variable et tronque
# la valeur, sur un simple avertissement (mesuré). `bootstrap.sh` écrit donc chaque valeur entre
# apostrophes, que Compose prend telle quelle, et engendre ses secrets en hexadécimal.
#
# Chaque variable que `compose.yml` interpole y figure, et aucune autre
# (`apps/api/tests/test_compose.py`). Les valeurs sont factices, sauf les noms de la base et de ses
# rôles — `POSTGRES_USER`, `POSTGRES_DB`, `BACKUP_POSTGRES_USER` —, que `bootstrap.sh` reprend
# tels quels. Ce fichier résout le Compose de production pour `make compose-config`, en CI comme
# sur le poste, et pour les piles jetables — celles de `infra/tests/` et celle du test de
# restauration mensuel (`.github/workflows/restore.yml`), dont l'environnement remplace les valeurs
# qu'il faut.

# L'étiquette des images du dépôt : le SHA complet du commit, que le job de déploiement fixe —
# jamais `latest` sur le VPS ; seul le test de restauration mensuel tire `latest` (`restore.yml`).
IMAGE_TAG=0000000000000000000000000000000000000000

# Le jeton du Tunnel Cloudflare (D45). `cloudflared` seul le reçoit.
TUNNEL_TOKEN=jeton-factice

# Les noms d'hôte publics : le site, l'API et son admin, les médias (ADR 0008). Caddy route par eux ;
# `api` n'accepte que les deux premiers. `API_HOST` vaut l'hôte de `VITE_API_URL` dans
# `apps/web/.env.production`, la seule origine que la CSP du site admet en `connect-src`.
SITE_HOST=site.example
API_HOST=api.example
MEDIA_HOST=media.example

# La clé de signature Django (`.env.example`).
SECRET_KEY=cle-factice

# Les identifiants du Postgres de production. Le mot de passe entre tel quel dans `DATABASE_URL` :
# sans caractère réservé d'URL.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=mot-de-passe-factice
POSTGRES_DB=portfolio

# La sauvegarde (`backup`, ADR 0007). Son rôle Postgres, en lecture seule, que `bootstrap.sh` crée :
# le nom repris d'ici, le mot de passe engendré.
BACKUP_POSTGRES_USER=portfolio_backup
BACKUP_POSTGRES_PASSWORD=mot-de-passe-factice
# La clé publique `age` qui chiffre les sauvegardes — pas un secret. La clé privée ne vient jamais
# sur le VPS (ADR 0007, point 2).
BACKUP_AGE_RECIPIENT=age1-cle-publique-factice
# Le bucket R2 des sauvegardes : l'adresse S3 du compte, le jeton borné à ce bucket, son nom.
BACKUP_R2_ENDPOINT=https://compte-factice.r2.cloudflarestorage.com
BACKUP_R2_ACCESS_KEY_ID=identifiant-factice
BACKUP_R2_SECRET_ACCESS_KEY=cle-factice
BACKUP_R2_BUCKET=backups
# L'adresse de ping healthchecks.io, un secret : qui la connaît signale une réussite à la place du
# conteneur.
BACKUP_PING_URL=https://hc-ping.com/uuid-factice
