# Modèle du `.env` de production, posé sur le VPS à côté de `compose.yml`, que Compose lit pour
# l'interpolation `${…}`. Aucune valeur réelle ici : `infra/bootstrap.sh` écrit ce `.env` depuis
# les secrets, jamais à la main (cadrage §6.6, §6.7 point 1).
#
# Compose interpole aussi les valeurs de ce fichier : un `$` y est lu comme une variable et tronque
# la valeur, sur un simple avertissement (mesuré). Un secret engendré n'en contient pas, ou s'écrit
# entre apostrophes.
#
# Chaque variable que `compose.yml` interpole y figure, et aucune autre
# (`apps/api/tests/test_compose.py`). Les valeurs sont factices : elles ne servent qu'à
# `make compose-config`, qui résout le Compose de production avec ce fichier, en CI comme sur le
# poste.

# L'étiquette des images du dépôt : le SHA complet du commit, que le job de déploiement fixe —
# jamais `latest`.
IMAGE_TAG=0000000000000000000000000000000000000000

# Le jeton du Tunnel Cloudflare (D45). `cloudflared` seul le reçoit.
TUNNEL_TOKEN=jeton-factice

# Les noms d'hôte publics : le site, l'API et son admin, les médias (ADR 0008). Caddy route par eux ;
# `api` n'accepte que les deux premiers.
SITE_HOST=site.example
API_HOST=api.example
MEDIA_HOST=media.example

# La clé de signature Django (`.env.example`).
SECRET_KEY=cle-factice

# Les identifiants du Postgres de production. Le mot de passe entre tel quel dans `DATABASE_URL` :
# sans caractère réservé d'URL.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=mot-de-passe-factice
POSTGRES_DB=portfolio
