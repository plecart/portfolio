# Caddyfile de production de l'image `caddy` (cadrage §5.3, ADR 0008). Caddy est le proxy interne
# du VPS, derrière `cloudflared`, seule entrée (D45) : il écoute en HTTP, Cloudflare termine TLS.
#
# Les noms d'hôte viennent de l'environnement du conteneur, lus au démarrage : le Compose de
# production les fixera (#16), le test de fumée (`infra/tests/test_caddy_image.py`) les remplace
# par des noms réservés aux tests.

{
	servers {
		# Caddy réécrit par défaut les `X-Forwarded-*` reçus d'après sa propre connexion, donc en
		# `http` depuis `cloudflared` (doc Caddy « reverse_proxy »). Venus du réseau privé, où vit
		# `cloudflared`, il les garde : le `X-Forwarded-Proto: https` du visiteur atteint Django
		# (`SECURE_PROXY_SSL_HEADER`, #6). Venus d'ailleurs, ils seraient forgés.
		trusted_proxies static private_ranges
	}
}

# L'hôte du site : le front compilé, que l'image copie dans `/usr/share/caddy` (ADR 0014).
http://{$SITE_HOST} {
	root * /usr/share/caddy

	# Les en-têtes de sécurité de l'hôte du site (PRD « Sécurité », brief de #16, décision 3) — sur
	# ce que Caddy sert comme sur `/projets/*` qu'il relaie. Le préfixe `>` diffère leur écriture
	# après celle de l'amont (doc Caddy « header ») : ceux de Django sont remplacés, pas doublés —
	# deux politiques de sécurité s'additionneraient. La politique n'admet que des fichiers servis
	# par le site, les appels à l'API et les images de `media`, sans `unsafe-inline` (OWASP « Content
	# Security Policy ») ; `data:` dans `img-src` seulement, pour l'icône vide d'`index.html` — une
	# image n'exécute rien, et c'est la seule violation mesurée sur le front compilé (2026-10-03). `X-Frame-Options` double `frame-ancestors` pour les navigateurs qui
	# l'ignorent (OWASP « Clickjacking Defense »). Pas de HSTS : le domaine `.dev` l'impose déjà.
	header {
		>Content-Security-Policy "default-src 'self'; connect-src https://{$API_HOST}; img-src 'self' data: https://{$MEDIA_HOST}; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		>X-Frame-Options DENY
		>X-Content-Type-Options nosniff
		>Referrer-Policy strict-origin-when-cross-origin
	}

	# La seule sortie HTML du back : la vue des aperçus de lien (ADR 0011, #14) répond sur l'adresse
	# d'une fiche, en injectant ses balises, ou redirige.
	handle /projets/* {
		reverse_proxy api:8000
	}

	# Les fichiers hachés de la compilation : leur nom porte une empreinte de leur contenu, il ne
	# désigne jamais qu'un contenu — mis en cache un an, sans revalidation. Un nom absent rend 404,
	# jamais `index.html` : servie sous un nom de script, la page resterait un an dans les caches.
	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		# `index.html` change à chaque compilation et cite les fichiers hachés du moment : revalidé
		# à chaque visite, jamais servi périmé.
		header Cache-Control no-cache

		# Le front route lui-même : un chemin qu'aucun fichier ne porte rend `index.html`.
		try_files {path} /index.html
		file_server
	}
}

# L'hôte de l'API : l'API publique et l'admin, tout entiers servis par `api` — statiques de l'admin
# compris, avec leurs propres en-têtes de cache (WhiteNoise, ADR 0014).
http://{$API_HOST} {
	reverse_proxy api:8000
}
