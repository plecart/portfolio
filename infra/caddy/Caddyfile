# Caddyfile de production de l'image `caddy` (cadrage §5.3, ADR 0008). Caddy est le proxy interne
# du VPS, derrière `cloudflared`, seule entrée (D45) : il écoute en HTTP, Cloudflare termine TLS.
#
# Les noms d'hôte viennent de l'environnement du conteneur, lus au démarrage : le Compose de
# production les fixera (#16), le test de fumée (`infra/tests/test_caddy_image.py`) les remplace
# par des noms réservés aux tests.

# L'hôte du site : le front compilé, que l'image copie dans `/usr/share/caddy` (ADR 0014).
http://{$SITE_HOST} {
	root * /usr/share/caddy

	# La seule sortie HTML du back : la vue des aperçus de lien (ADR 0011, #14) répond sur l'adresse
	# d'une fiche, en injectant ses balises, ou redirige.
	handle /projets/* {
		reverse_proxy api:8000
	}

	# Les fichiers hachés de la compilation : leur nom porte une empreinte de leur contenu, il ne
	# désigne jamais qu'un contenu — mis en cache un an, sans revalidation. Un nom absent rend 404,
	# jamais `index.html` : servie sous un nom de script, la page resterait un an dans les caches.
	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		# `index.html` change à chaque compilation et cite les fichiers hachés du moment : revalidé
		# à chaque visite, jamais servi périmé.
		header Cache-Control no-cache

		# Le front route lui-même : un chemin qu'aucun fichier ne porte rend `index.html`.
		try_files {path} /index.html
		file_server
	}
}

# L'hôte de l'API : l'API publique et l'admin, tout entiers servis par `api` — statiques de l'admin
# compris, avec leurs propres en-têtes de cache (WhiteNoise, ADR 0014).
http://{$API_HOST} {
	reverse_proxy api:8000
}
