{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(git fetch *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh label *)",
      "Bash(gh api repos/*)",
      "Bash(npx skills *)",
      "Bash(rtk read *)",
      "Bash(rtk grep *)",
      "Bash(rtk wc *)",
      "Bash(rtk ls *)",
      "Bash(rtk make test)",
      "Bash(rtk proxy make test)",
      "Bash(rtk make lint)",
      "Bash(rtk make typecheck)",
      "Bash(rtk make format-check)",
      "Bash(rtk make audit)",
      "Bash(rtk make web-audit)",
      "Bash(rtk make web-test)",
      "Bash(rtk proxy make web-test)",
      "Bash(rtk make web-lint)",
      "Bash(rtk make web-typecheck)",
      "Bash(rtk gh pr *)",
      "Bash(rtk gh issue *)",
      "Bash(rtk gh run list *)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs"
    ],
    "deny": [
      "Read(.env)",
      "Bash(rtk read *.env*)",
      "Bash(rtk grep *.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push -uf*)",
      "Bash(git push * -uf*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -c \"(New-Object Media.SoundPlayer 'C:\\Windows\\Media\\chimes.wav').PlaySync()\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -c \"(New-Object Media.SoundPlayer 'C:\\Windows\\Media\\tada.wav').PlaySync()\"",
            "async": true
          }
        ]
      }
    ]
  }
}
