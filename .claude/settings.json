{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(git add :*)",
      "Bash(git commit :*)",
      "Bash(git checkout :*)",
      "Bash(git switch :*)",
      "Bash(git branch :*)",
      "Bash(git worktree :*)",
      "Bash(git fetch :*)",
      "Bash(git status)",
      "Bash(git diff :*)",
      "Bash(git log :*)",
      "Bash(gh issue :*)",
      "Bash(gh pr :*)",
      "Bash(gh label :*)",
      "Bash(gh api repos/:*)",
      "Bash(npx skills :*)"
    ],
    "deny": [
      "Read(.env)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -c \"(New-Object Media.SoundPlayer 'C:\\Windows\\Media\\chimes.wav').PlaySync()\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -c \"(New-Object Media.SoundPlayer 'C:\\Windows\\Media\\tada.wav').PlaySync()\"",
            "async": true
          }
        ]
      }
    ]
  }
}
