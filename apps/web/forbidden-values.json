[
  {
    "name": "couleur hexadécimale",
    "pattern": "#([0-9a-f]{3,4}|[0-9a-f]{6}|[0-9a-f]{8})([^0-9a-z-]|$)"
  },
  {
    "name": "fonction de couleur",
    "pattern": "(^|[^0-9a-z-])(rgba?|hsla?|hwb|lab|lch|oklab|oklch|color)[(]"
  },
  {
    "name": "durée à unité",
    "pattern": "(^|[^0-9a-z.-])[0-9]*[.]?[0-9]+m?s([^0-9a-z-]|$)"
  },
  {
    "name": "durée numérique de Tailwind",
    "pattern": "(^|[^0-9a-z-])(duration|delay)-[0-9]"
  },
  {
    "name": "fonction de courbe",
    "pattern": "(^|[^0-9a-z-])(cubic-bezier|linear|steps)[(]"
  },
  {
    "name": "courbe linéaire de Tailwind",
    "pattern": "(^|[^0-9a-z-])ease-linear([^0-9a-z-]|$)"
  }
]
