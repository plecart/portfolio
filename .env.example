# Variables d'environnement du back (`apps/api`). Aucune valeur secrète dans ce fichier.
#
# Développement : copier en `.env` et compléter. Production : `.env` est écrit par
# `infra/bootstrap.sh` depuis les secrets, jamais édité à la main (cadrage §6.6, §6.7 point 1).
#
# Chaque variable est lue par la classe `Env` (`apps/api/config/env.py`), et par elle seule.
# Exception : `ENV_FILE`, qui désigne ce fichier, ne peut évidemment pas y être déclarée. Posée
# dans l'environnement, elle fait lire un autre chemin — ou aucun, si le chemin n'existe pas.
# Une clé inconnue **dans ce fichier** fait échouer le démarrage : c'est une faute de frappe,
# pas une option. (Une variable inconnue de l'environnement du processus, elle, est ignorée —
# le système en pose des dizaines.)

# Clé de signature Django. Sans défaut : son absence empêche le démarrage.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Mode de développement. Absent = faux, donc posture de production. Ne jamais mettre `true`
# ailleurs que sur un poste de développement.
DEBUG=true

# Noms d'hôte servis, en JSON. Obligatoire dès que DEBUG est faux (Django l'exige) : sans eux
# le démarrage échoue, au lieu de laisser le site répondre en erreur à chaque requête.
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Adresse du Postgres applicatif (ADR 0005). `127.0.0.1` et non `localhost` : le Compose de
# développement publie ses ports pour `127.0.0.1` seulement, et sous Windows `localhost` se
# résout d'abord en `::1` — chaque connexion attendrait son délai avant de se replier.
DATABASE_URL=postgresql://utilisateur:mot-de-passe@127.0.0.1:5432/portfolio

# Adresse du Redis (ADR 0006), même hôte pour la même raison. Elle sert de broker au worker
# d'images (Celery, ADR 0015) ; le cache Django la lira aussi, avec l'issue #11.
REDIS_URL=redis://127.0.0.1:6379/0

# Dossier des fichiers téléversés (ADR 0004 : disque en développement, R2 en production).
# Un chemin relatif est ancré sur la racine du dépôt, jamais sur le dossier courant — `manage.py`
# se lance depuis `apps/api`, les tests depuis la racine. Le conteneur, lui, reçoit le chemin
# absolu de son volume par `infra/compose.dev.yml`, qui prime sur ce fichier.
MEDIA_ROOT=media

# Où vont les fichiers téléversés : `disk`, sous MEDIA_ROOT, ou `r2`, le bucket public des images
# sur Cloudflare R2 (ADR 0004) — en production seulement. Toute autre valeur empêche le démarrage ;
# avec `r2`, chacune des cinq variables suivantes est obligatoire. Le disque les ignore.
MEDIA_STORAGE=disk

# L'hôte public des fichiers sous `r2`, le CDN devant le bucket (`media.pacome.dev` en
# production) : l'adresse d'un fichier est `https://<MEDIA_HOST>/<chemin>`.
MEDIA_HOST=

# Le bucket R2 des fichiers : l'adresse S3 du compte (`https://<compte>.r2.cloudflarestorage.com`),
# le nom du bucket public des images — jamais celui des sauvegardes —, et le jeton borné à ce
# bucket, qui doit pouvoir le lister : la suppression d'une image liste le dossier de son original.
MEDIA_R2_ENDPOINT=
MEDIA_R2_BUCKET=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=

# Origines admises à appeler l'API publique, en JSON (ADR 0008 : CORS restreint à l'origine du
# site). Chacune est un schéma et un hôte, rien d'autre ; au moins une, sans quoi le démarrage
# échoue. Sur le poste, le navigateur parle au back depuis le serveur de développement Vite.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# L'unique superutilisateur de l'admin, que le conteneur `api` crée ou met à jour à chaque
# démarrage (`manage.py ensure_superuser`) : vides, ce démarrage échoue. Le mot de passe passe les
# validateurs de Django — 12 caractères au moins, ni courant, ni entièrement numérique, ni proche
# du nom.
ADMIN_USERNAME=
ADMIN_PASSWORD=
