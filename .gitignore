# Python / uv
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.env

# Front (apps/web) — un seul fichier d'exclusion pour le dépôt, comme il n'y a qu'un `Makefile`
node_modules/
apps/web/dist/
apps/web/test-results/
apps/web/playwright-report/
apps/web/.lighthouseci/

# Fichiers téléversés. `MEDIA_ROOT` vaut `media` dans `.env.example` et, sans valeur, se résout
# sur la racine du dépôt : sans cette ligne, le premier téléversement sur le poste se retrouverait
# prêt à être commité. Dans le conteneur, ces fichiers vivent dans un volume et ne passent pas ici.
/media/

# La clé privée `age` des sauvegardes, que `make restore` lit par défaut à la racine du clone le
# temps d'une restauration (`infra/RUNBOOK.md`) : jamais dans le dépôt (ADR 0007, point 2).
/age.key

# Claude Code — surcharges locales
.claude/settings.local.json

# Instantanés et journaux de console du serveur MCP `playwright` (`.mcp.json`), écrits à la racine
# du clone à chaque vérification au navigateur.
.playwright-mcp/

# strix (pentest, docs/frontend-outillage.md §2.2)
strix_runs/

# Le schéma d'architecture s'exporte du JSON voisin, seul versionné ; l'image vit dans la galerie
# (#217, « Décisions »).
docs/schema/architecture.png

# Les worktrees que le harnais crée pour les équipiers, et l'application pour les sessions liées.
# Non ignorés, ils entreraient dans la population des portes qui énumèrent le dépôt par le système
# de fichiers — mesuré le 2026-10-09 sur le tableau de bord d'une vague, alors à la racine : il
# citait un module de test d'une branche en vol et rendait rouge
# `test_aucun_renvoi_vers_un_module_de_test_inexistant` sur le seul poste. Le tableau vit hors du
# dépôt depuis le lot 3 de #107 (`pr-paralleles`, étape 4).
.claude/worktrees/
apps/web/.vitest/
